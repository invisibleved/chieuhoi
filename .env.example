DATABASE_URI=postgres://postgres:postgres@localhost:5433/chieuhoi
DATABASE_URI_TEST=postgres://postgres:postgres@localhost:5433/chieuhoi_test
PAYLOAD_SECRET=change-me-to-a-long-random-string
APP_ENV=development
PREVIEW_ALL=true
SEED_REVIEWER_EMAIL=reviewer@example.com
SEED_REVIEWER_PASSWORD=change-me
# Chỉ đặt true khi cần tạo người duyệt đầu tiên qua admin trên DB trống (dev). Production: để false
# và dùng `npm run create-reviewer` với REVIEWER_EMAIL / REVIEWER_PASSWORD.
ALLOW_FIRST_USER=false
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
